<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (API 30 and below) full-backup rules for audit L12.

  NOT CURRENTLY REFERENCED FROM THE MANIFEST — see the note in
  data_extraction_rules.xml. The release pipeline disables backup outright by
  patching gogio to emit android:allowBackup="false", which is the control that
  actually ships. These exclusions are the list to apply for older devices IF
  backup is ever deliberately re-enabled: the SQLite database and the sealed
  keystore + its key must never be included in an adb or cloud backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="vayumail" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
