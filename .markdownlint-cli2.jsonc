// markdownlint configuration.
//
// The standing instructions have listed `markdownlint-cli2 <changed .md>` as a pre-push gate for
// a long time without CI running it, so nothing ever established what "passing"
// meant. This file decides that, and the CI job now enforces it.
//
// The split is between rules that change how a document RENDERS and rules that
// only describe how its source is typed. The first kind stays on: a list with
// no blank line before it silently becomes a paragraph in some parsers, and a
// fenced block with no language loses its highlighting. The second kind is off,
// because a gate that fires 123 times on line width teaches people to stop
// reading its output — and a gate nobody reads is worse than no gate.
{
  "config": {
    "default": true,

    // Off: source style, not rendering.
    //
    // MD013 line width — the prose here already wraps near 80 by habit, but
    // reference tables, badge rows and URLs do not, and reflowing them would
    // trade readable source for a passing number.
    "MD013": false,
    // MD033 inline HTML — the README's badge row is HTML by necessity.
    "MD033": false,
    // MD060 table pipe padding — invisible in every renderer.
    "MD060": false,

    // On, but scoped the way the standing instructions describe it: duplicate headings are a
    // problem WITHIN one section, not across a changelog where every release
    // legitimately has its own "Fixed".
    "MD024": { "siblings_only": true },

    // MD004 stays at its default (consistent bullet style). It is the rule
    // the standing instructions name by number, because a wrapped line beginning with `*` or
    // `+` is read as a new bullet and quietly restructures the list.
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", ".git/**"]
}
