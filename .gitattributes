# Line-ending policy.
#
# WHY THIS EXISTS (audit 2026-08, finding L1): gofmt flags CRLF sources, and a
# Windows checkout with core.autocrlf=true converted every Go file on clone,
# so `gofmt -l .` reported the whole tree unformatted and the pre-push gate
# was unusable off Linux. Pinning text sources to LF makes every gate read
# the same bytes on every OS.
#
# Explicit allowlist rather than a blanket "* text=auto": the MIME fixtures in
# test/fixtures/mime/ are RFC 5322 wire samples whose CRLF bytes ARE the thing
# under test — renormalizing them would silently change what they prove.

*.go    text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.xml   text eol=lf
*.java  text eol=lf

# Toolchain manifests: `go mod tidy` emits LF even on Windows, and an
# autocrlf checkout flipping them to CRLF makes every subsequent status
# report phantom modifications.
go.mod  text eol=lf
go.sum  text eol=lf

# Byte-exact regardless of platform or git config.
*.eml -text

*.png      binary
*.jpg      binary
*.webp     binary
*.ico      binary
*.jar      binary
*.keystore binary
